OUTPUT_FORMAT("elf64-littleriscv", "elf64-littleriscv", "elf64-littleriscv")
OUTPUT_ARCH(riscv)
ENTRY(_start)

SECTIONS
{
  . = KERNEL_MAP_BASE;

  .text : AT(ADDR(.text) - KERNEL_MAP_BASE)
  {
    __text_start = .;
    /* Force boot code to offset 0 */
    *(.boot.text)
    *(.text.start)
    *(.text .stub .text.* .gnu.linkonce.t.*)
  }

  .rodata ALIGN(0x1000) : AT(ADDR(.rodata) - KERNEL_MAP_BASE)
  {
    *(.rodata .rodata.* .gnu.linkonce.r.*)
  }

  .data ALIGN(0x1000) : AT(ADDR(.data) - KERNEL_MAP_BASE)
  {
    *(.data .data.* .gnu.linkonce.d.*)
    *(.got .got.*)
    *(.got.plt)
    *(.sdata .sdata.* .gnu.linkonce.s.*)
    . = ALIGN(8);
    _edata = .;
    PROVIDE_HIDDEN (__global_pointer$ = _edata);
  }

  .bss ALIGN(0x1000) (NOLOAD) : AT(ADDR(.bss) - KERNEL_MAP_BASE)
  {
    *(.sbss .sbss.* .gnu.linkonce.sb.*)
    *(.bss .bss.* .gnu.linkonce.b.*)
    *(COMMON)
  }

  . = ALIGN(0x1000);
  _end = .;
  PROVIDE (end = .);

  /DISCARD/ :
  {
    *(.note.GNU-stack)
    *(.gnu_debuglink)
    *(.gnu.lto_*)
  }
}
